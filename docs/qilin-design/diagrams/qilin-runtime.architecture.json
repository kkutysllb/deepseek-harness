    },
    {
      "dot": "emerald",
      "title": "子代理与多智能体 (v2.0.0)",
      "items": [
        "Sub-Agent 与 Lead Agent 同构，独立 checkpoint 可递归",
        "OrchestratorGraph + AgentInbox + Handoff 支持协作模式",
        "orchestration.mode 切换属图结构变更，需重启"
      ]
    },
    {
      "dot": "amber",
      "title": "纵深防御 · guardrails / sandbox / authz",
      "items": [
        "InputPolish 与 SafetyFinishReason 覆盖输入/输出面",
        "SandboxProvider 屏蔽本地 fork、Docker、E2B、BoxLite、Tenki",
        "authz.rbac 提供资源级 RBAC，per-agent 配额独立"
      ]
    },
    {
      "dot": "violet",
      "title": "可观测与配置热重载",
      "items": [
        "Langfuse + Monocle 双适配，X-Trace-Id 贯穿全链路",
        "Run Events 统一 envelope，落 SQLite / JSONL",
        "ConfigSignature 触发子配置热重载，结构性配置需重启"
      ]
    }
