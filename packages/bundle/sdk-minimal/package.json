{
  "name": "@qilin/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/deepseek-llm-api-extensions": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/jobs-local": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/llm-retry": "workspace:^",
    "@qilin/plugin-package-inventory-deepseek": "workspace:^",
    "@qilin/sandbox-local": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/scope": "workspace:^",
    "@qilin/sdk-app": "workspace:^",
    "@qilin/sdk-jsonrpc-server": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-log-deepseek": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/session-title": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/terminal": "workspace:^",
    "@qilin/terminal-bash": "workspace:^",
    "@qilin/tool-bash-persistent": "workspace:^",
    "@qilin/tool-pwsh-persistent": "workspace:^",
    "@qilin/tool-str-replace-editor": "workspace:^",
    "@qilin/tools": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@qilin/invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
