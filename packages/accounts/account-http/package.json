{
  "name": "@qilin/account-http",
  "description": "Account HTTP surface: /api/v1/auth route family, the /api authentication gate, cookie policy, Origin whitelist, and rate limiting on the webServer",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/accounts/account-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@qilin/account-auth": "workspace:^",
    "@qilin/account-core": "workspace:^",
    "@qilin/host-webserver": "workspace:^",
    "@qilin/invariants": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@qilin/account-auth": "workspace:^",
    "@qilin/account-core": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/host-webserver": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "typescript": "^6.0.3"
  }
}
