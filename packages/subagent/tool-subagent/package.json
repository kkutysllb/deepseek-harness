    "@qilin/session": "workspace:^",
    "@qilin/session-persistence": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subagent-spawn-in-process": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/jobs": "workspace:^",
    "@qilin/jobs-local": "workspace:^",
    "@qilin/tool-jobs": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
