{
  "name": "@qilin/subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/sdk-client": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^"
  },
  "dependencies": {
    "@qilin/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-instructions": "workspace:^",
    "@qilin/app-boot": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/loader-smoke": "workspace:^",
    "@qilin/sdk-client": "workspace:^",
    "@qilin/sdk-protocol": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-checkpoint-policy": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/skill-filesystem": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tool-subagent": "workspace:^"
  }
}
