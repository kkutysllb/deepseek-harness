{
  "name": "@qilin/subagent-acp",
  "description": "Out-of-process ACP subagent backend: drives a child agent in a spawned subprocess over the Agent Client Protocol",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/timeout": "workspace:^"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@qilin/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/app-boot": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/loader-smoke": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-checkpoint-policy": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/timeout": "workspace:^",
    "@qilin/tool-subagent": "workspace:^"
  }
}
